# .env 템플릿 (copy to .env — gitignored, 실제 값은 절대 커밋 금지).
#
#   cp .env.example .env
#   $EDITOR .env
#   bash init-host.sh          # 상태 디렉터리 사전 생성 (idempotent)

# ---- Image / container identity ----
IMAGE_NAME=devbox:latest
CONTAINER_NAME=devbox-<user>
# 공유 호스트에서는 clone/사용자마다 반드시 달라야 한다. 같으면 Docker Compose 가
# 모든 clone 을 같은 project 의 dev 서비스로 취급해서, 한 사람의 rebuild/up 이
# 다른 사람의 devcontainer 를 recreate 할 수 있다.
COMPOSE_PROJECT_NAME=devbox-<user>

# ---- Dev user UID / GID (build args) ----
# bind mount 경로를 소유한 호스트 유저와 일치시킨다. 확인: id -u && id -g
# 바꾸면 "Rebuild Container" 필요.
DEV_UID=1000
DEV_GID=1000

# ---- SSH ----
# 호스트에 노출할 sshd 포트 (컨테이너 22 로 매핑). 공유 호스트에서는 사용자별로
# 다르게. network_mode: host 파생에서는 무시된다 (compose 에서 ports 제거).
SSH_PORT=2222

# ---- AI CLI toggles (build args) ----
INSTALL_CLAUDE_CODE=true
INSTALL_CODEX=false

# ---- AI CLI state persistence ----
# 디렉터리. Claude 전역 설정 파일은 <CLAUDE_STATE_DIR>.json (형제 파일)로
# 파생된다 (docker-compose.yml + init-host.sh) — 별도 변수 없음.
# init-host.sh 가 DEV_UID:DEV_GID 소유로 만들어 준다.
CLAUDE_STATE_DIR=/path/to/state/<user>/claude
CODEX_STATE_DIR=/path/to/state/<user>/codex

# ---- Git identity (optional) ----
# 공유 서버에서 호스트 ~/.gitconfig 전달로 남의 identity 가 박히는 것 방어.
GIT_USER_NAME=
GIT_USER_EMAIL=

# ---- Dataset/storage mounts ----
# /data 로 마운트된다.
DATA_PATH=/path/to/data
